#!/bin/bash
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

set -e

display_error() {
    echo -e "${RED}❌ $1${NC}"
    exit 1
}

if [ -f "vendor/bin/sail" ]; then
    SAIL="SAIL_XDEBUG_MODE=off ./vendor/bin/sail"
else
    display_error "Sail not found! Please run containers."
fi

echo -e "${YELLOW}Running pre-push checks...${NC}"

# PHPStan / Larastan (Static Analysis)
echo -e "🔍 Running PHPStan..."

$SAIL bin phpstan analyse --memory-limit=2G || display_error "PHPStan found issues"

# Run PHPUnit tests
echo -e "🧪 Running Tests..."

$SAIL test || display_error "PHPUnit tests failed"

echo -e "${GREEN}✅ Pre-push checks passed! Ready to push.${NC}"
exit 0
